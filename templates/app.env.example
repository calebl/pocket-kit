# Settings for one locally run app. Keep the real file outside the repo, at
# ~/.config/myapp/env, readable only by you: chmod 600 ~/.config/myapp/env

# The port the app listens on, on 127.0.0.1 only.
PORT=3100

RAILS_ENV=production
# Generate with: bin/rails secret
SECRET_KEY_BASE=

# The https address the VPN gives this machine, so the app accepts requests for it.
APP_HOST=mymachine.example-tailnet.ts.net

# The command the feedback button hands notes to (see the README). Leave unset
# to hide the button.
FEEDBACK_COMMAND=

# The command grouped error reports are handed to (see the README). Leave
# unset to turn error reporting off.
ERRORS_COMMAND=
